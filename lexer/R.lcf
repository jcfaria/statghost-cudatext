  SampleText.Strings = (
    '# R highlighter sample                      # Comment'
    '#. Note_1                                   # Note_1'
    '#.. Note_2                                  # Note_2'
    '#... Note_3                                 # Note_3'
    '# Notes never execute — colour only         # Comment'
    'pB <- 3.5E2                                 # Float number'
    '0 1 2 3 4 5 6 8 9                           # Numbers'
    '           '
    'variable_a = 1:100                          # Identifier'
    'variable.b <- 1:100                         # Identifier'
    ''
    '+ - * / %*% ^ = <- -> <> ~ $ ? ! & :        # Operator'
